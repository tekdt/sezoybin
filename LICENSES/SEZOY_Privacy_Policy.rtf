\par\pard\f0\fs28\b 1. D\u7919? li\u7879?u ch\u250?ng t\u244?i thu th\u7853?p v\u224? x\u7917? l\u253?\b0\par
\pard\f0\fs24 SEZOY x\u7917? l\u253? th\u244?ng tin theo hai ph\u7841?m vi kh\u225?c nhau:\par
\pard\li720\fi-360\tx720\f0\fs24 \u8226?\tab \b Th\u244?ng tin \u273?\u432?\u7907?c g\u7917?i v\u7873? server qua Internet:\b0  \u7903? l\u7847?n k\u237?ch ho\u7841?t \u273?\u7847?u ti\u234?n, SEZOY c\u243? th\u7875? g\u7917?i \b m\u227? thi\u7871?t b\u7883? (device fingerprint)\b0  \u273?\u227? \u273?\u432?\u7907?c m\u227? h\u243?a v\u224? c\u7855?t chu\u7895?i. M\u227? n\u224?y \u273?\u432?\u7907?c d\u249?ng cho m\u7909?c \u273?\u237?ch k\u237?ch ho\u7841?t, x\u225?c th\u7921?c, ch\u7889?ng l\u7841?m d\u7909?ng v\u224? v\u7853?n h\u224?nh d\u7883?ch v\u7909?.\par
\pard\li720\fi-360\tx720\f0\fs24 \u8226?\tab \b Th\u244?ng tin ch\u7881? \u273?\u432?\u7907?c x\u7917? l\u253? c\u7909?c b\u7897? khi ph\u7847?n m\u7873?m \u273?ang ch\u7841?y:\b0  SEZOY c\u243? th\u7875? t\u7841?o v\u224? s\u7917? d\u7909?ng t\u7841?m th\u7901?i m\u7897?t s\u7889? th\u244?ng tin k\u7929? thu\u7853?t, tr\u7841?ng th\u225?i giao di\u7879?n, thi\u7871?t b\u7883? \u273?\u227? ch\u7885?n, ISO \u273?\u227? ch\u7885?n, edition \u273?\u227? ch\u7885?n, tr\u7841?ng th\u225?i driver, danh s\u225?ch ph\u7847?n m\u7873?m v\u224? c\u225?c gi\u225? tr\u7883? v\u7853?n h\u224?nh t\u432?\u417?ng t\u7921? trong b\u7897? nh\u7899? ho\u7863?c tr\u7841?ng th\u225?i ch\u7841?y c\u7911?a ch\u432?\u417?ng tr\u236?nh. C\u225?c gi\u225? tr\u7883? n\u224?y ch\u7881? ph\u7909?c v\u7909? cho vi\u7879?c v\u7853?n h\u224?nh \u7913?ng d\u7909?ng khi \u273?ang m\u7903?. Ch\u250?ng \b kh\u244?ng \u273?\u432?\u7907?c g\u7917?i v\u7873? server qua Internet\b0 , \b kh\u244?ng \u273?\u432?\u7907?c l\u432?u tr\u234?n server c\u7911?a ch\u250?ng t\u244?i\b0 , v\u224? nh\u236?n chung s\u7869? bi\u7871?n m\u7845?t khi ch\u432?\u417?ng tr\u236?nh b\u7883? \u273?\u243?ng, tr\u7915? khi ng\u432?\u7901?i d\u249?ng ch\u7911? \u273?\u7897?ng l\u432?u th\u224?nh c\u7845?u h\u236?nh c\u7909?c b\u7897? ho\u7863?c xu\u7845?t file theo ch\u7913?c n\u259?ng ri\u234?ng.\par
\pard\f0\fs24 Khi SEZOY th\u7921?c hi\u7879?n c\u225?c thao t\u225?c h\u7879? th\u7889?ng theo y\u234?u c\u7847?u c\u7911?a ng\u432?\u7901?i d\u249?ng, ch\u7859?ng h\u7841?n nh\u432? th\u234?m ch\u7913?ng ch\u7881? v\u224?o Trusted Root ho\u7863?c \u273?i\u7873?u ch\u7881?nh quy\u7873?n chia s\u7867? th\u432? m\u7909?c, c\u225?c thay \u273?\u7893?i \u273?\u243? \u273?\u432?\u7907?c th\u7921?c hi\u7879?n c\u7909?c b\u7897? tr\u234?n thi\u7871?t b\u7883? c\u7911?a ng\u432?\u7901?i d\u249?ng. \u272?\u243? l\u224? thay \u273?\u7893?i c\u7845?u h\u236?nh, kh\u244?ng ph\u7843?i d\u7919? li\u7879?u \u273?o t\u7915? xa, v\u224? kh\u244?ng \u273?\u432?\u7907?c truy\u7873?n v\u7873? server c\u7911?a ch\u250?ng t\u244?i tr\u7915? khi m\u7897?t t\u237?nh n\u259?ng tr\u7921?c tuy\u7871?n ri\u234?ng bi\u7879?t y\u234?u c\u7847?u nh\u432? v\u7853?y.\par
\par\pard\f0\fs28\b 2. M\u7909?c \u273?\u237?ch s\u7917? d\u7909?ng d\u7919? li\u7879?u\b0\par
\pard\f0\fs24 Ch\u250?ng t\u244?i s\u7917? d\u7909?ng th\u244?ng tin n\u234?u tr\u234?n \u273?\u7875?:\par
\pard\li720\fi-360\tx720\f0\fs24 \u8226?\tab k\u237?ch ho\u7841?t v\u224? x\u225?c th\u7921?c ph\u7847?n m\u7873?m;\par
\pard\li720\fi-360\tx720\f0\fs24 \u8226?\tab ng\u259?n ch\u7863?n vi\u7879?c s\u7917? d\u7909?ng tr\u225?i ph\u233?p, l\u7841?m d\u7909?ng ho\u7863?c can thi\u7879?p sai m\u7909?c \u273?\u237?ch;\par
\pard\li720\fi-360\tx720\f0\fs24 \u8226?\tab cung c\u7845?p c\u225?c t\u237?nh n\u259?ng t\u7841?o Boot, Boot server PXE, t\u237?ch h\u7907?p ISO, t\u237?ch h\u7907?p driver, t\u249?y bi\u7871?n unattended, gi\u225?m s\u225?t v\u224? c\u224?i \u273?\u7863?t ph\u7847?n m\u7873?m sau Windows;\par
\pard\li720\fi-360\tx720\f0\fs24 \u8226?\tab ghi nh\u7899? c\u225?c thi\u7871?t l\u7853?p do ng\u432?\u7901?i d\u249?ng ch\u7885?n khi s\u7843?n ph\u7849?m \u273?\u432?\u7907?c thi\u7871?t k\u7871? \u273?\u7875? kh\u244?i ph\u7909?c phi\u234?n l\u224?m vi\u7879?c tr\u432?\u7899?c \u273?\u243?;\par
\pard\li720\fi-360\tx720\f0\fs24 \u8226?\tab hi\u7875?n th\u7883? tr\u7841?ng th\u225?i v\u224? h\u7895? tr\u7907? ng\u432?\u7901?i d\u249?ng ho\u224?n t\u7845?t quy tr\u236?nh;\par
\pard\li720\fi-360\tx720\f0\fs24 \u8226?\tab c\u7843?i thi\u7879?n \u273?\u7897? \u7893?n \u273?\u7883?nh, \u273?\u7897? tin c\u7853?y v\u224? kh\u7843? n\u259?ng t\u432?\u417?ng th\u237?ch;\par
\pard\li720\fi-360\tx720\f0\fs24 \u8226?\tab h\u7895? tr\u7907? k\u7929? thu\u7853?t v\u224? x\u7917? l\u253? l\u7895?i khi ng\u432?\u7901?i d\u249?ng li\u234?n h\u7879? v\u7899?i ch\u250?ng t\u244?i.\par
\par\pard\f0\fs28\b 3. Chia s\u7867? d\u7919? li\u7879?u\b0\par
\pard\f0\fs24 Ch\u250?ng t\u244?i kh\u244?ng b\u225?n d\u7919? li\u7879?u c\u225? nh\u226?n c\u7911?a b\u7841?n.\par
\pard\f0\fs24 Ch\u250?ng t\u244?i ch\u7881? c\u243? th\u7875? ti\u7871?t l\u7897? th\u244?ng tin trong c\u225?c tr\u432?\u7901?ng h\u7907?p sau:\par
\pard\li720\fi-360\tx720\f0\fs24 \u8226?\tab \b V\u7853?n h\u224?nh d\u7883?ch v\u7909?:\b0  \u273?\u7875? x\u7917? l\u253? y\u234?u c\u7847?u k\u237?ch ho\u7841?t ho\u7863?c c\u225?c y\u234?u c\u7847?u d\u7883?ch v\u7909? c\u7847?n thi\u7871?t cho ph\u7847?n m\u7873?m ho\u7841?t \u273?\u7897?ng.\par
\pard\li720\fi-360\tx720\f0\fs24 \u8226?\tab \b Tu\u226?n th\u7911? ph\u225?p lu\u7853?t:\b0  khi vi\u7879?c ti\u7871?t l\u7897? \u273?\u432?\u7907?c y\u234?u c\u7847?u b\u7903?i lu\u7853?t, quy\u7871?t \u273?\u7883?nh c\u7911?a t\u242?a \u225?n ho\u7863?c y\u234?u c\u7847?u h\u7907?p l\u7879? t\u7915? c\u417? quan c\u243? th\u7849?m quy\u7873?n.\par
\pard\li720\fi-360\tx720\f0\fs24 \u8226?\tab \b B\u7843?o m\u7853?t v\u224? ch\u7889?ng l\u7841?m d\u7909?ng:\b0  khi c\u7847?n b\u7843?o v\u7879? ph\u7847?n m\u7873?m, ng\u432?\u7901?i d\u249?ng ho\u7863?c h\u7879? th\u7889?ng c\u7911?a ch\u250?ng t\u244?i kh\u7887?i gian l\u7853?n, l\u7841?m d\u7909?ng ho\u7863?c c\u225?c m\u7889?i \u273?e d\u7885?a an ninh.\par
\pard\li720\fi-360\tx720\f0\fs24 \u8226?\tab \b H\u224?nh \u273?\u7897?ng do ng\u432?\u7901?i d\u249?ng ch\u7911? \u273?\u7897?ng th\u7921?c hi\u7879?n:\b0  khi b\u7841?n ch\u7885?n t\u7843?i ISO, driver ho\u7863?c g\u243?i d\u7919? li\u7879?u kh\u225?c t\u7915? nh\u224? cung c\u7845?p b\u234?n th\u7913? ba th\u244?ng qua c\u225?c t\u237?nh n\u259?ng m\u224? b\u7841?n s\u7917? d\u7909?ng, nh\u224? cung c\u7845?p \u273?\u243? c\u243? th\u7875? x\u7917? l\u253? d\u7919? li\u7879?u theo ch\u237?nh s\u225?ch ri\u234?ng c\u7911?a h\u7885?.\par
\par\pard\f0\fs28\b 4. Th\u224?nh ph\u7847?n v\u224? d\u7883?ch v\u7909? b\u234?n th\u7913? ba\b0\par
\pard\f0\fs24 SEZOY c\u243? th\u7875? bao g\u7891?m ho\u7863?c t\u432?\u417?ng t\u225?c v\u7899?i c\u225?c c\u244?ng c\u7909? v\u224? th\u224?nh ph\u7847?n b\u234?n th\u7913? ba nh\u432? 7-Zip, aria2, iPXE Bootloaders, busybox, ChromeDriver, erofs-utils, Fido, MSEdgeDriver, noVNC, oscdimg, Ventoy, wimlib, WinCDEmu v\u224? Add-on WinDivert (t\u7843?i t\u249?y ch\u7885?n cho Wi-Fi Hotspot). M\u7895?i th\u224?nh ph\u7847?n b\u234?n th\u7913? ba v\u7851?n ch\u7883?u s\u7921? \u273?i\u7873?u ch\u7881?nh c\u7911?a gi\u7845?y ph\u233?p, th\u244?ng b\u225?o b\u7843?n quy\u7873?n v\u224? \u273?i\u7873?u ki\u7879?n s\u7917? d\u7909?ng ri\u234?ng c\u7911?a ch\u237?nh n\u243?.\par
\pard\f0\fs24 M\u7897?t s\u7889? t\u237?nh n\u259?ng c\u243? th\u7875? c\u7847?n k\u7871?t n\u7889?i m\u7841?ng \u273?\u7875? t\u7843?i file ho\u7863?c l\u7845?y link t\u7915? nh\u224? cung c\u7845?p b\u234?n ngo\u224?i. Khi b\u7841?n s\u7917? d\u7909?ng c\u225?c t\u237?nh n\u259?ng \u273?\u243?, nh\u224? cung c\u7845?p li\u234?n quan c\u243? th\u7875? x\u7917? l\u253? th\u244?ng tin theo ch\u237?nh s\u225?ch b\u7843?o m\u7853?t v\u224? \u273?i\u7873?u kho\u7843?n ri\u234?ng c\u7911?a h\u7885?.\par
\pard\f0\fs24 Add-on WinDivert (driver WinDivert v\u224? pydivert bindings) kh\u244?ng \u273?\u432?\u7907?c \u273?\u243?ng g\u243?i k\u232?m SEZOY. Th\u224?nh ph\u7847?n n\u224?y ch\u7881? \u273?\u432?\u7907?c t\u7843?i t\u7915? ngu\u7891?n ch\u237?nh th\u7913?c khi b\u7841?n \u273?\u7891?ng \u253? r\u245? r\u224?ng v\u224? v\u7851?n ch\u7883?u s\u7921? \u273?i\u7873?u ch\u7881?nh c\u7911?a gi\u7845?y ph\u233?p ri\u234?ng c\u7911?a n\u243? (LGPLv3).\par
\par\pard\f0\fs28\b 5. Th\u7901?i gian l\u432?u gi\u7919? d\u7919? li\u7879?u\b0\par
\pard\f0\fs24 M\u227? thi\u7871?t b\u7883? \u273?\u432?\u7907?c g\u7917?i \u7903? l\u7847?n k\u237?ch ho\u7841?t \u273?\u7847?u ti\u234?n c\u243? th\u7875? \u273?\u432?\u7907?c l\u432?u gi\u7919? trong th\u7901?i gian c\u7847?n thi\u7871?t \u273?\u7875? ph\u7909?c v\u7909? k\u237?ch ho\u7841?t, x\u225?c th\u7921?c, ph\u242?ng ch\u7889?ng gian l\u7853?n, qu\u7843?n l\u253? gi\u7845?y ph\u233?p, h\u7895? tr\u7907? k\u7929? thu\u7853?t ho\u7863?c tu\u226?n th\u7911? ph\u225?p lu\u7853?t; sau \u273?\u243? s\u7869? b\u7883? x\u243?a ho\u7863?c \u273?\u432?\u7907?c \u7849?n danh h\u243?a kh\u244?ng th\u7875? kh\u244?i ph\u7909?c khi kh\u244?ng c\u242?n c\u7847?n thi\u7871?t, t\u249?y theo ngh\u297?a v\u7909? ph\u225?p l\u253? \u225?p d\u7909?ng.\par
\pard\f0\fs24 Th\u244?ng tin n\u7897?i b\u7897? ch\u7881? t\u7891?n t\u7841?i trong b\u7897? nh\u7899? ch\u7841?y t\u7841?m th\u7901?i c\u7911?a ch\u432?\u417?ng tr\u236?nh s\u7869? kh\u244?ng \u273?\u432?\u7907?c l\u432?u tr\u234?n server c\u7911?a ch\u250?ng t\u244?i. Tr\u7915? khi b\u7841?n ch\u7911? \u273?\u7897?ng l\u432?u c\u7845?u h\u236?nh c\u7909?c b\u7897?, xu\u7845?t b\u225?o c\u225?o ho\u7863?c b\u7853?t t\u237?nh n\u259?ng ghi file tr\u234?n thi\u7871?t b\u7883? c\u7911?a m\u236?nh, c\u225?c th\u244?ng tin n\u224?y th\u432?\u7901?ng s\u7869? bi\u7871?n m\u7845?t khi ph\u7847?n m\u7873?m \u273?\u243?ng l\u7841?i.\par
\par\pard\f0\fs28\b 6. B\u7843?o m\u7853?t\b0\par
\pard\f0\fs24 Ch\u250?ng t\u244?i \u225?p d\u7909?ng c\u225?c bi\u7879?n ph\u225?p b\u7843?o v\u7879? h\u7907?p l\u253? v\u7873? k\u7929? thu\u7853?t, t\u7893? ch\u7913?c v\u224? qu\u7843?n tr\u7883? \u273?\u7875? b\u7843?o v\u7879? th\u244?ng tin m\u224? ch\u250?ng t\u244?i x\u7917? l\u253?. Kh\u244?ng c\u243? ph\u432?\u417?ng th\u7913?c truy\u7873?n ho\u7863?c l\u432?u tr\u7919? n\u224?o l\u224? an to\u224?n tuy\u7879?t \u273?\u7889?i, nh\u432?ng ch\u250?ng t\u244?i lu\u244?n c\u7889? g\u7855?ng gi\u7843?m thi\u7875?u r\u7911?i ro b\u7857?ng ki\u7875?m so\u225?t truy c\u7853?p, gi\u7899?i h\u7841?n th\u7901?i gian l\u432?u gi\u7919? v\u224? thi\u7871?t k\u7871? t\u237?nh n\u259?ng ph\u249? h\u7907?p.\par
\par\pard\f0\fs28\b 7. Quy\u7873?n v\u224? l\u7921?a ch\u7885?n c\u7911?a b\u7841?n\b0\par
\pard\f0\fs24 B\u7841?n c\u243? th\u7875? l\u7921?a ch\u7885?n c\u243? s\u7917? d\u7909?ng c\u225?c t\u237?nh n\u259?ng y\u234?u c\u7847?u k\u237?ch ho\u7841?t tr\u7921?c tuy\u7871?n, t\u7843?i d\u7919? li\u7879?u t\u7915? b\u234?n ngo\u224?i ho\u7863?c thay \u273?\u7893?i c\u7845?u h\u236?nh h\u7879? th\u7889?ng c\u7909?c b\u7897? hay kh\u244?ng. B\u7841?n c\u361?ng c\u243? th\u7875? ch\u7885?n c\u225?c thi\u7871?t l\u7853?p t\u249?y \u253?, file ISO, driver v\u224? ph\u7847?n m\u7873?m sau c\u224?i \u273?\u7863?t trong t\u7915?ng quy tr\u236?nh c\u7909? th\u7875?.\par
\pard\f0\fs24 N\u7871?u b\u7841?n kh\u244?ng mu\u7889?n SEZOY x\u7917? l\u253? m\u227? thi\u7871?t b\u7883? \u273?\u7875? k\u237?ch ho\u7841?t, b\u7841?n kh\u244?ng n\u234?n ho\u224?n t\u7845?t quy tr\u236?nh k\u237?ch ho\u7841?t l\u7847?n \u273?\u7847?u.\par
\par\pard\f0\fs28\b 8. Quy\u7873?n ri\u234?ng t\u432? c\u7911?a tr\u7867? em\b0\par
\pard\f0\fs24 SEZOY l\u224? c\u244?ng c\u7909? k\u7929? thu\u7853?t ph\u7909?c v\u7909? tri\u7875?n khai h\u7879? th\u7889?ng v\u224? kh\u244?ng d\u224?nh ri\u234?ng cho tr\u7867? em. N\u7871?u b\u7841?n ch\u432?a \u273?\u7911? \u273?\u7897? tu\u7893?i theo quy \u273?\u7883?nh \u273?\u7883?a ph\u432?\u417?ng \u273?\u7875? t\u7921? \u273?\u7891?ng \u253? v\u7899?i c\u225?c d\u7883?ch v\u7909? tr\u7921?c tuy\u7871?n, b\u7841?n ch\u7881? n\u234?n s\u7917? d\u7909?ng ph\u7847?n m\u7873?m khi c\u243? s\u7921? gi\u225?m s\u225?t v\u224? cho ph\u233?p ph\u249? h\u7907?p.\par
\par\pard\f0\fs28\b 9. Thay \u273?\u7893?i ch\u237?nh s\u225?ch n\u224?y\b0\par
\pard\f0\fs24 Ch\u250?ng t\u244?i c\u243? th\u7875? c\u7853?p nh\u7853?t Ch\u237?nh s\u225?ch b\u7843?o m\u7853?t n\u224?y theo th\u7901?i gian \u273?\u7875? ph\u7843?n \u225?nh thay \u273?\u7893?i c\u7911?a ph\u7847?n m\u7873?m, y\u234?u c\u7847?u ph\u225?p l\u253? ho\u7863?c c\u225?ch x\u7917? l\u253? d\u7919? li\u7879?u. Phi\u234?n b\u7843?n m\u7899?i nh\u7845?t s\u7869? c\u243? hi\u7879?u l\u7921?c khi \u273?\u432?\u7907?c c\u244?ng b\u7889?.\par
\par\pard\f0\fs28\b 10. Li\u234?n h\u7879?\b0\par
\pard\f0\fs24 N\u7871?u b\u7841?n c\u243? c\u226?u h\u7887?i v\u7873? Ch\u237?nh s\u225?ch b\u7843?o m\u7853?t n\u224?y ho\u7863?c c\u225?ch SEZOY x\u7917? l\u253? th\u244?ng tin, vui l\u242?ng li\u234?n h\u7879? TekDT qua k\u234?nh h\u7895? tr\u7907? ch\u237?nh th\u7913?c \u273?i k\u232?m ph\u7847?n m\u7873?m.\par
